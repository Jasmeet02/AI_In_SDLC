+    [Fact]
+    public void Submit_ChangesDraftToPendingApproval_WhenRepositoryStartsWithDraft()
+    {
+        var repository = new FakeInvoiceRepository(InvoiceWith("INV-99", InvoiceStatus.Draft));
+        var service = new ApprovalService(repository);
+
+        var result = service.Submit("INV-99");
+
+        Assert.Equal(InvoiceStatus.PendingApproval, result.Status);
+        Assert.Equal(InvoiceStatus.PendingApproval, repository.GetById("INV-99")!.Status);
+    }
+
+    [Fact]
+    public void Reject_StoresReasonOnTheRejectedInvoice()
+    {
+        var repository = new FakeInvoiceRepository(InvoiceWith("INV-100", InvoiceStatus.PendingApproval));
+        var service = new ApprovalService(repository);
+
+        var result = service.Reject("INV-100", "demo.approver", "Duplicate invoice");
+
+        Assert.Equal("Duplicate invoice", result.DecisionNote);
+        Assert.Equal("demo.approver", result.DecidedBy);
+    }
